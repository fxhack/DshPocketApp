<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 应用仅连接电脑上的 dsh-pocket 代理（局域网 http://IP:3081），允许明文流量 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
